# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port (default: 3000 for pay.gnbmentor.com, 3001 for portal.gnbmentor.com)
PORT=3000

# STRIPE CONFIGURATION:
STRIPE_PUBLISHABLE_KEY="pk_live_your_stripe_publishable_key"
STRIPE_SECRET_KEY="sk_live_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_signing_secret"

# GOOGLE PAY BUSINESS API CONFIGURATION:
# Approved Merchant ID from Google Pay & Wallet Console (e.g. BCR2DN4TZCDIREQ4)
GOOGLE_PAY_MERCHANT_ID="BCR2DN4TZCDIREQ4"
GOOGLE_PAY_MERCHANT_NAME="GNB MENTOR"
GOOGLE_PAY_ENV="PRODUCTION"

# HMAC INTEGRITY SECRET:
# Shared secret key between WordPress (gnbmentor.com) and pay.gnbmentor.com
HMAC_SECRET_KEY="gnbmentor_secure_default_secret_2026"

# WOOCOMMERCE INTEGRATION:
WOOCOMMERCE_STORE_URL="https://gnbmentor.com"
WOOCOMMERCE_WEBHOOK_SECRET="optional_wc_webhook_secret_key"

# PORTAL.GNBMENTOR.COM & LOCALHOST IPC CONFIGURATION:
# Internal loopback connection on the same Namecheap AlmaLinux VPS
PORTAL_PUBLIC_URL="https://portal.gnbmentor.com"
PORTAL_INTERNAL_URL="http://127.0.0.1:3001"
INTERNAL_SECRET_KEY="gnbmentor_internal_vps_secret_2026"

# NAMECHEAP RESELLER API CONFIGURATION:
# Note: Whitelist your Namecheap AlmaLinux VPS static IP in Namecheap Profile > Tools > API Access
NAMECHEAP_API_USER="your_namecheap_username"
NAMECHEAP_API_KEY="your_namecheap_api_key"
NAMECHEAP_CLIENT_IP="your_vps_public_ip"
NAMECHEAP_SANDBOX=false

# GOOGLE PARTNER SALES CONSOLE & WORKSPACE RESELLER:
GOOGLE_RESELLER_CUSTOMER_ID="C0xxxxxxx"
GOOGLE_MAPS_PARTNER_PROJECT_ID="gnbmentor-maps-partner"
